{
  "name": "coursehub",
  "version": "0.4.3-beta.2",
  "description": "CourseHub - 课堂交互与学习任务测试工作台 (Electron + React 18 + TypeScript)",
  "private": true,
  "main": "./out/main/index.js",
  "author": "Qiuizi",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/qiuizi/CourseHub.git"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node tests/e2e/run-e2e.mjs",
    "build": "npm run typecheck && electron-vite build",
    "dist:win": "npm run build && electron-builder --win --x64 --config electron-builder.yml"
  },
  "dependencies": {
    "leaflet": "1.9.4",
    "lucide-react": "0.544.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/leaflet": "1.9.20",
    "@types/node": "22.20.5",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "44.7.2",
    "electron-builder": "26.15.3",
    "electron-vite": "4.0.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "3.2.7"
  }
}
